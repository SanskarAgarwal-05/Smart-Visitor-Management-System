# Server Port
PORT=5000

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<db_cluster_url>/<db_name>?retryWrites=true&w=majority

# JWT Token configuration (Must be changed to a secure, random string in production)
JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated list of origins, e.g. for Vercel deployment)
CORS_ORIGIN=https://smart-visitor-frontend.vercel.app,http://localhost:5173
